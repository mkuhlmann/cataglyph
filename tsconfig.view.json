{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": [],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true,
        "jsx": "preserve"
    },
    "include": ["src/view/**/*.ts", "src/view/**/*.vue", "src/shared/**/*.ts", "env.d.ts"]
}
